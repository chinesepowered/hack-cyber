# Copy to .env and fill in. .env is gitignored.

# ClickHouse Cloud (GCP asia-northeast1 / Tokyo)
CLICKHOUSE_URL=https://YOUR-SERVICE.asia-northeast1.gcp.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=beagle

# Local ClickHouse for offline development (docker compose up)
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_USER=beagle
# CLICKHOUSE_PASSWORD=beagle

# ClickHouse Cloud management API (optional, used by scripts/ch_service.sh)
CLICKHOUSE_API_KEY_ID=
CLICKHOUSE_API_KEY_SECRET=
CLICKHOUSE_ORG_ID=
CLICKHOUSE_SERVICE_ID=

# Guild.ai
GUILD_API_KEY=

# ElevenLabs (demo video narration only, not a hackathon sponsor)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=tpS5zOAgWUiQMhzYbG2h

# Semgrep: the CLI needs no key for local rules. A token is only needed to
# push findings to the Semgrep cloud dashboard. Get one at
# semgrep.dev -> Settings -> Tokens (account level, not per repo).
SEMGREP_APP_TOKEN=

# Pipeline tuning
BEAGLE_USER_AGENT=beagle-brigade/0.1 (cyberdefense hackathon scanner)
BEAGLE_SANDBOX_DIR=./sandbox
BEAGLE_MAX_ARCHIVE_BYTES=67108864
BEAGLE_MAX_FILE_BYTES=4194304
BEAGLE_CONCURRENCY=8
